# The CDK app is a PEX: the CDK CLI runs it (tools/deploy.py passes
# --app "python3 dist/apps.{{ app_name }}.infra/cdk_app.pex"). Pants owns its deps, so
# a change to libs/cdk_constructs marks this app as affected.
pex_binary(
    name="cdk_app",
    entry_point="{{ pkg_name }}_infra/app.py",
    execution_mode="venv",
)
